rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null && request.auth.token.email != null;
    }

    function isValidSyncDoc() {
      return request.resource.data.sync_id is string
        && request.resource.data.sync_id.size() > 0
        && request.resource.data.updated_at is string
        && request.resource.data.updated_at.size() > 0;
    }

    match /cabinets/{syncId} {
      allow read: if isSignedIn();
      allow create, update: if isSignedIn() && isValidSyncDoc();
      allow delete: if isSignedIn();
    }

    match /books/{syncId} {
      allow read: if isSignedIn();
      allow create, update: if isSignedIn() && isValidSyncDoc();
      allow delete: if isSignedIn();
    }

    match /borrowers/{syncId} {
      allow read: if isSignedIn();
      allow create, update: if isSignedIn() && isValidSyncDoc();
      allow delete: if isSignedIn();
    }

    match /loans/{syncId} {
      allow read: if isSignedIn();
      allow create, update: if isSignedIn() && isValidSyncDoc();
      allow delete: if isSignedIn();
    }

    match /library_meta/{docId} {
      allow read, write: if isSignedIn();
    }

    // Live UI/Server/Updater string overrides queue (promoted automatically by GitHub Actions)
    match /ui_strings/{stringKey} {
      allow read: if isSignedIn();
      allow create, update: if isSignedIn()
        && request.resource.data.key is string
        && request.resource.data.key == stringKey
        && request.resource.data.value is string
        && request.resource.data.value.size() > 0
        && request.resource.data.value.size() <= 1000
        && request.resource.data.updatedAt is string
        && request.resource.data.promoted_desktop is bool
        && request.resource.data.promoted_mobile is bool;
      allow delete: if isSignedIn();
    }

    // Temporary relay queue for compressed cover images from Android APK -> Desktop
    // Desktop immediately downloads locally and deletes the Firestore document
    match /ai_relay_queue/{relayId} {
      allow read, delete: if isSignedIn();
      allow create, update: if isSignedIn()
        && request.resource.data.relay_id is string
        && request.resource.data.image_base64 is string
        && request.resource.data.image_base64.size() > 0
        && request.resource.data.image_base64.size() <= 900000
        && request.resource.data.created_at is string;
    }

    // Bug Reports collection
    match /bug_reports/{reportId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn()
        && request.resource.data.title is string
        && request.resource.data.title.size() > 0
        && request.resource.data.created_at is string;
      allow update: if isSignedIn();
      allow delete: if isSignedIn();
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}