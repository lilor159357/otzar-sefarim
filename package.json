{
  "name": "otzar-sefarim",
  "version": "1.0.36",
  "private": true,
  "type": "module",
  "main": "dist-electron/main.cjs",
  "scripts": {
    "dev": "tsx server/index.ts",
    "build": "vite build && tsc --noEmit",
    "build:electron": "node scripts/build-electron.mjs",
    "electron:dev": "npm run build && npm run build:electron && electron .",
    "dist:win": "npm run build && npm run build:electron && electron-builder --win nsis --publish never",
    "dist:dir": "npm run build && npm run build:electron && electron-builder --win --dir",
    "start": "tsx server/index.ts",
    "check:strings": "node scripts/check-strings-parity.mjs"
  },
  "dependencies": {
    "@google/genai": "^2.4.0",
    "@pdf-lib/fontkit": "^1.1.1",
    "bidi-js": "^1.1.0",
    "bwip-js": "^4.11.4",
    "electron-updater": "^6.8.11",
    "express": "^4.21.2",
    "firebase": "^13.4.0",
    "lucide-react": "^0.546.0",
    "pdf-lib": "^1.17.1",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "sql.js": "^1.12.0",
    "xlsx": "^0.18.5"
  },
  "optionalDependencies": {
    "better-sqlite3": "^11.8.1"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.14",
    "@types/express": "^4.17.21",
    "@types/node": "^22.14.0",
    "@types/react": "^19.0.10",
    "@types/react-dom": "^19.0.4",
    "@vitejs/plugin-react": "^4.3.4",
    "electron": "^45.4.1",
    "electron-builder": "^26.18.0",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.19.3",
    "typescript": "^5.8.2",
    "vite": "^6.2.3"
  }
}
